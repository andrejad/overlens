# systemd unit for Overlens on Linux. Install steps are in docs/DEPLOY.md ("Linux route").
[Unit]
Description=Overlens
After=network.target

[Service]
Type=simple
User=overlens
Group=overlens
WorkingDirectory=/var/lib/overlens
ExecStart=/opt/overlens/overlens -config /etc/overlens/overlens.conf
Restart=on-failure
RestartSec=5
# The program shuts down gracefully on SIGTERM within 10 seconds.
TimeoutStopSec=20

# Hardening: the program only needs to write to its data, log and backup folders.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/overlens /var/log/overlens /var/backups/overlens

[Install]
WantedBy=multi-user.target
